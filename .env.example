# Example environment variables for KanoonVault
# Copy this file to `.env` and fill in your own keys. Do NOT commit your `.env` file.

# Chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Vision OCR (Gemma 4 — dual OCR with PaddleOCR)
OCR_VISION_API_KEY=
OCR_VISION_MODEL=google/gemma-4-31b-it:free
OCR_VISION_URL=https://openrouter.ai/api/v1/chat/completions

# Timeline extraction
TIMELINE_API_KEY=
TIMELINE_MODEL=google/gemma-4-31b-it:free
TIMELINE_URL=https://openrouter.ai/api/v1/chat/completions

MAX_CONTEXT_CHARS=6000
UPLOAD_DIR=uploads
PORT=8000
